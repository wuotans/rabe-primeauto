{
  "name": "ServiceOrder",
  "type": "object",
  "properties": {
    "os_number": {
      "type": "string",
      "description": "N\u00famero da OS gerado automaticamente"
    },
    "client_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "client_phone": {
      "type": "string",
      "description": "Telefone do cliente"
    },
    "has_contract": {
      "type": "boolean",
      "default": false,
      "description": "Cliente com contrato"
    },
    "vehicle": {
      "type": "string",
      "description": "Modelo do ve\u00edculo"
    },
    "plate": {
      "type": "string",
      "description": "Placa do ve\u00edculo"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de servi\u00e7os selecionados"
    },
    "service_costs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "cost": {
            "type": "number",
            "default": 0
          }
        }
      },
      "description": "Custo de materiais por servi\u00e7o"
    },
    "total_cost": {
      "type": "number",
      "default": 0,
      "description": "Custo total de materiais em R$"
    },
    "service_category": {
      "type": "string",
      "enum": [
        "Lava-Jato",
        "Est\u00e9tica",
        "Funilaria",
        "Polimento",
        "Reparo de Pintura",
        "Reparo de Rodas",
        "Completo",
        "Outro"
      ],
      "description": "Categoria principal do servi\u00e7o"
    },
    "damages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Avarias pr\u00e9-existentes registradas"
    },
    "observations": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aguardando",
        "Em Andamento",
        "Conclu\u00eddo",
        "Liberado"
      ],
      "default": "Aguardando",
      "description": "Status atual da OS"
    },
    "value": {
      "type": "number",
      "default": 0,
      "description": "Valor total do servi\u00e7o em R$"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "Cart\u00e3o",
        "PIX",
        "Dinheiro",
        "Contrato",
        "Cortesia",
        "Ficha"
      ],
      "description": "Forma de pagamento"
    },
    "checkin_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de entrada"
    },
    "checkout_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de sa\u00edda"
    },
    "damage_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de fotos das avarias"
    }
  },
  "required": [
    "client_name",
    "vehicle",
    "plate",
    "services"
  ]
}